# ── TaskFlow Sentinel — copy to .env before `docker compose up --build` ──

# Database (service name `postgres` inside the Docker network)
DATABASE_URL=postgresql+asyncpg://taskflow:taskflow@postgres:5432/taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow
POSTGRES_DB=taskflow
POSTGRES_PORT=5432

# Redis (service name `redis`)
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# Backend
API_HOST=0.0.0.0
API_PORT=8000
HEARTBEAT_INTERVAL=2
FAILURE_TIMEOUT=6
MAX_TASK_RETRIES=3
DEFAULT_SCHEDULING_ALGORITHM=RESOURCE_AWARE
FRONTEND_URL=http://localhost:3000
SEED_HISTORY=true
LOG_LEVEL=INFO

# Workers (resource limits are configurable — lower them if Docker Desktop is tight)
WORKER_CPUS=1
WORKER_MEMORY_LIMIT=1G
WORKER_CONCURRENCY=4

# Frontend (Vite reads these at build/dev time)
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/dashboard

# Optional pgAdmin (docker compose --profile tools up)
PGADMIN_EMAIL=admin@taskflow.local
PGADMIN_PASSWORD=taskflow
PGADMIN_PORT=5050
